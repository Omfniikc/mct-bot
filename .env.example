# ─── Telegram ───
# Токен бота от @BotFather
TG_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Telegram user id администратора (узнать можно у @userinfobot)
ADMIN_ID=123456789

# ─── Нейросеть (Tokify / OpenAI-совместимый API) ───
# Ключ для распознавания еды по фото и голосу.
# TOKIFY_API_KEY используется напрямую; GPT_VISION_TOKEN / GPT_TR_TOKEN
# оставлены для совместимости (если не задан TOKIFY_API_KEY, берётся GPT_VISION_TOKEN).
TOKIFY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOKIFY_BASE_URL=https://tokify.sale/v1
GPT_VISION_TOKEN=
GPT_TR_TOKEN=

# ─── База данных ───
DB_PATH=./main.db

# ─── ЮKassa ───
# shopId из личного кабинета ЮKassa и секретный ключ.
# Для тестирования используй ключ с префиксом test_ (деньги не списываются).
SHOP_ID=123456
PAY_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Webhook ───
WEBHOOK_HOST=mycaloriesai.ru
WEBHOOK_PORT=8444
WEBHOOK_PATH=/webhook/bot2

# Режим работы: true = long polling, false = webhook
POLING=true

# Прокси для запросов к Telegram. Пусто = без прокси.
# Примеры: http://127.0.0.1:12334, socks5://127.0.0.1:12334
PROXY_URL=socks5://127.0.0.1:12334
